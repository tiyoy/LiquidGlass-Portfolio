# Supabase project URL and public anon/publishable key (safe for browser when RLS is configured)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only key. Never expose this to NEXT_PUBLIC variables or commit it.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Admin email must match the user created in Supabase Authentication.
ADMIN_EMAIL="admin@example.com"
